# Writes FartSamples.cpp: every WAV in resources/farts/ as a byte array, by id (the file name). Run at build time
# (cmake -DSOURCE=<resources/farts> -DOUT=<file> -P EmbedFartSamples.cmake), so the samples are committed only as
# WAVs; tools/prepare_fart_samples.py makes them.

file(GLOB samples RELATIVE "${SOURCE}" "${SOURCE}/*.wav")
list(SORT samples)

set(arrays "")
set(lookup "")
foreach(sample IN LISTS samples)
  get_filename_component(id "${sample}" NAME_WLE)
  string(MAKE_C_IDENTIFIER "${id}" name)
  file(READ "${SOURCE}/${sample}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n    " hex "${hex}")
  string(APPEND arrays "const unsigned char k_${name}[] = {\n    ${hex}\n};\n\n")
  string(APPEND lookup "    if (std::strcmp(id, \"${id}\") == 0)\n        return { k_${name}, sizeof(k_${name}) };\n")
endforeach()

set(content "// Generated by cmake/EmbedFartSamples.cmake from resources/farts/ - do not edit.

#include \"engine/blocks/FartSamples.hpp\"

#include <cstring>

namespace xythos {

namespace {

${arrays}} // namespace

EmbeddedFile builtinFartSample([[maybe_unused]] const char* id)
{
${lookup}    return { nullptr, 0 };
}

} // namespace xythos
")

# only touch the file when it changes, so a rebuild doesn't recompile it
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
