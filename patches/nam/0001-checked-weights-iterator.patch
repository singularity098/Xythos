diff --git a/NAM/weights_iterator.h b/NAM/weights_iterator.h
new file mode 100644
index 0000000..755e84f
--- /dev/null
+++ b/NAM/weights_iterator.h
@@ -0,0 +1,54 @@
+#pragma once
+// Xythos patch (patches/nam/): a bounds-checked cursor over a model's weights. The loaders read weights with
+// *(it++) as the config dictates, so a model file with fewer weights than its config needs read past the end of the
+// vector (found by fuzzing). Reading past the end now throws instead.
+
+#include <cstddef>
+#include <stdexcept>
+#include <vector>
+
+namespace nam
+{
+class WeightsIterator
+{
+public:
+  explicit WeightsIterator(std::vector<float>& weights)
+  : _weights(&weights)
+  , _data(weights.data())
+  , _size(weights.size())
+  {
+  }
+
+  float& operator*() const
+  {
+    if (_index >= _size)
+      throw std::runtime_error("Model has fewer weights than its configuration needs");
+    return _data[_index];
+  }
+  WeightsIterator& operator++()
+  {
+    ++_index;
+    return *this;
+  }
+  WeightsIterator operator++(int)
+  {
+    WeightsIterator before = *this;
+    ++_index;
+    return before;
+  }
+
+  // Comparisons with the vector's own iterators (it != weights.end())
+  bool equals(const std::vector<float>::iterator& other) const
+  {
+    return static_cast<std::ptrdiff_t>(_index) == other - _weights->begin();
+  }
+  bool operator==(const std::vector<float>::iterator& other) const { return equals(other); }
+  bool operator!=(const std::vector<float>::iterator& other) const { return !equals(other); }
+
+private:
+  std::vector<float>* _weights;
+  float* _data;
+  size_t _size;
+  size_t _index = 0;
+};
+} // namespace nam
